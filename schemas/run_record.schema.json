{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunRecord",
  "type": "object",
  "required": ["timestamp", "run_id", "config_id", "model_id", "mode", "parameters", "report_id", "status", "prompt_hash", "usage", "estimated_cost_usd"],
  "additionalProperties": false,
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "minLength": 1},
    "config_id": {"type": "string", "minLength": 1},
    "model_id": {"type": ["string", "null"]},
    "mode": {"type": "string", "minLength": 1},
    "parameters": {
      "type": "object", "required": ["temperature", "max_output_tokens"], "additionalProperties": false,
      "properties": {"temperature": {"type": ["number", "null"]}, "max_output_tokens": {"type": "integer", "minimum": 0}}
    },
    "report_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ok", "error", "replay", "mock"]},
    "prompt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "response_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "usage": {
      "type": "object", "required": ["input_tokens", "output_tokens"], "additionalProperties": false,
      "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}}
    },
    "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "error": {"type": "string"}
  }
}
